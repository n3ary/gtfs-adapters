{
  "$schema": "https://biomejs.dev/schemas/2.6.8/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "**/*.ts",
      "**/*.tsx",
      "**/*.js",
      "**/*.jsx",
      "**/*.mjs",
      "**/*.cjs",
      "**/*.json",
      "!**/node_modules",
      "!**/dist"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 120
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended"
    }
  },
  "javascript": {
    "formatter": {
      "lineWidth": 120,
      "quoteStyle": "single"
    }
  },
  "overrides": [
    {
      "includes": ["**/src/**", "**/tests/**"],
      "linter": {
        "rules": {
          "complexity": {
            "useLiteralKeys": "off",
            "useOptionalChain": "off"
          },
          "correctness": {
            "noUnusedFunctionParameters": "off",
            "noUnusedImports": "off",
            "noUnusedPrivateClassMembers": "off",
            "noUnusedVariables": "off"
          },
          "style": {
            "noNonNullAssertion": "off",
            "useTemplate": "off"
          },
          "suspicious": {
            "noExplicitAny": "off",
            "noImplicitAnyLet": "off",
            "noTemplateCurlyInString": "off"
          }
        }
      }
    }
  ]
}
